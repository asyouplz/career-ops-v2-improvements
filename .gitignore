# Generated output and caches
artifacts*/
backup-*/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/node_modules/
.DS_Store

# Local runtime configuration and personal career evidence
config/runtime.json
config/runtime-bootstrap-apply.json
config/dashboard.json
config/profile_evidence.json
config/linkedin_queries.json

# Production deployment records contain live cron, Slack, execution, and host IDs.
# They remain in the local working copy but are intentionally not versioned.
staging/

# Environment files and credentials
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Do not reintroduce full upstream checkouts alongside the bundled runtime.
/test-project/
/career-ops/
/upstream/
/vendor/

.venv/
.venv-*/
/engine/data/
/engine/reports/
/engine/output/
/engine/batch/
/engine/config/
/engine/cv.md
/engine/portals.yml
/engine/plugins.local/
/engine/plugins.lock

# Private source documents and runtime records
/data/
/reports/
/output/
/jds/
/interview-prep/
/writing-samples/
/cv.md
/article-digest.md
/portals.yml
/config/profile.yml
/config/cv-facts.json
/config/plugins.yml
/modes/_profile.md
/modes/_custom.md
/modes/_brief.md
/.mcp.json
/plugins.local/
/plugins.lock

# No testing or demonstration artifacts are distributed.
**/tests/
**/test/
**/fixtures/
**/__tests__/
**/__mocks__/
**/*.test.*
**/*.spec.*
**/test_*.py
**/*_test.go
**/demo.gif

# Private dashboard deployments and mail evidence never belong in source control.
dashboard/web/dist/
dashboard/web/.next/
dashboard/web/.wrangler/
dashboard/**/.private/
dashboard/**/revisions/
dashboard/**/deploy/
dashboard/**/data/
dashboard/**/backups/
dashboard/**/gmail-accounts/
dashboard/**/mail-thread-cache/
dashboard/**/provider-diagnostics/
dashboard/**/gmail.json
dashboard/**/client_secret*.json
dashboard/**/token*.json
