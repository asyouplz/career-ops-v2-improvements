{
  "schema_version": 1,
  "activation_mode": "dry-run",
  "production_project_root": "/absolute/path/to/career-ops-project",
  "production_hermes_home": "/absolute/path/to/hermes-home",
  "node_bin": "/absolute/path/to/node",
  "codex_bin": "/absolute/path/to/codex",
  "legacy_prerun_script": "/absolute/path/to/career_ops_daily_scan.py",
  "legacy_ddgs_script": "/absolute/path/to/linkedin_site_search_fetch.py",
  "collector_timeout_seconds": 300,
  "include_mail_in_dry_run": false,
  "include_collector_in_dry_run": false,
  "enable_no_response_closure": true,
  "no_response_close_days": 60,
  "no_response_close_max_per_run": 20,
  "max_compact_payload_bytes": 10000,
  "identity_resolver_script": "/absolute/path/to/identity-resolver.mjs",
  "identity_resolver_timeout_seconds": 10,
  "mail_review_queue_path": "/absolute/path/to/data/mail-review-queue.json",
  "max_candidates": 5,
  "max_liveness_checks": 12,
  "max_processed_candidates": 4,
  "max_linkedin_rechecks": 1,
  "liveness_cache_ttl_days": 7,
  "recommendation_cooldown_days": 7,
  "recommendation_history_path": "/absolute/path/to/data/recommendation-history.json",
  "slack_delivery": {
    "enabled": false,
    "target": "slack:YOUR_CHANNEL_ID",
    "hermes_bin": "/absolute/path/to/hermes",
    "root_active_preview_limit": 5,
    "root_max_chars": 2400
  },
  "protected_files": []
}
